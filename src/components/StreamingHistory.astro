---
// Room ID mapping extracted from bilibili API
const roomIdMap: Record<string, string> = {
  '喵铃': '1882952804',
  '迷宝': '1728862031',
  '狸悠': '10551481',
  '琦琳': '1980122165',
  '芙内巫斯': '3295853',
  '汐音': '1726395633',
};
const API_BASE = import.meta.env.DEV ? '/api' : 'https://streaming-time.rotcool.top';
---

<section class="streaming-history section-pad" id="streaming-history">
  <div class="container">
    <h2 class="section-title">直播历史</h2>
    <p class="section-lead">主播们的直播记录与最新状态</p>

    <div class="history-grid" id="history-grid">
      <div class="loading-state">
        <div class="loading-spinner"></div>
        <p>加载直播历史中...</p>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ roomIdMap, API_BASE }}>
  const SHANGHAI_OFFSET_MS = 8 * 60 * 60 * 1000;
  const APPOINTMENT_WEEK_MS = 7 * 24 * 60 * 60 * 1000;
  const appointmentDateFormatter = new Intl.DateTimeFormat('zh-CN', {
    timeZone: 'Asia/Shanghai',
    month: 'numeric',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    hourCycle: 'h23',
  });

  function getNextAppointment(schedule) {
    if (!Array.isArray(schedule) || schedule.length !== 7) return null;

    const now = Date.now();
    const shanghaiNow = new Date(now + SHANGHAI_OFFSET_MS);
    const todayIndex = (shanghaiNow.getUTCDay() + 6) % 7;
    let nextTime = Infinity;

    schedule.forEach((dayTimes, dayIndex) => {
      if (!Array.isArray(dayTimes)) return;
      dayTimes.forEach((appointment) => {
        if (typeof appointment !== 'string') return;
        const match = /^(\d{2}):(\d{2})(?:-\d{2}:\d{2})?$/.exec(appointment.trim());
        if (!match) return;
        const hour = Number(match[1]);
        const minute = Number(match[2]);
        if (hour > 23 || minute > 59) return;

        const daysAhead = (dayIndex - todayIndex + 7) % 7;
        const shanghaiTarget = Date.UTC(
          shanghaiNow.getUTCFullYear(),
          shanghaiNow.getUTCMonth(),
          shanghaiNow.getUTCDate() + daysAhead,
          hour,
          minute,
        );
        let targetTime = shanghaiTarget - SHANGHAI_OFFSET_MS;
        if (targetTime <= now) targetTime += APPOINTMENT_WEEK_MS;
        nextTime = Math.min(nextTime, targetTime);
      });
    });

    if (!Number.isFinite(nextTime)) return null;
    const parts = appointmentDateFormatter.formatToParts(new Date(nextTime));
    const part = (type) => parts.find((item) => item.type === type)?.value ?? '';
    return `${part('month')}月${part('day')}日 ${part('hour')}:${part('minute')}`;
  }


  
  async function loadStreamingHistory() {
    const grid = document.getElementById('history-grid');
    if (!grid) return;

    try {
      // Get last 30 days of sessions for all streamers
      const endTime = Math.floor(Date.now() / 1000);
      const startTime = endTime - 30 * 24 * 60 * 60;

      const historyPromises = Object.entries(roomIdMap).map(async ([name, roomId]) => {
        try {
          const queryRes = await fetch(
            `${API_BASE}/query?room_id=${roomId}&startTime=${startTime}&endTime=${endTime}`
          );
          const data = await queryRes.json();
          
          // Get live status
          const infoRes = await fetch(`${API_BASE}/getInfo?room_id=${roomId}`);
          const info = await infoRes.json();
          
          return {
            name,
            roomId,
            sessions: data.sessions || [],
            isLive: info?.data?.live_status === 1,
            liveTime: info?.data?.live_time,
            nextAppointment: getNextAppointment(data.appointments),
          };
        } catch (err) {
          console.error(`Failed to fetch ${name}:`, err);
          return { name, roomId, sessions: [], isLive: false };
        }
      });

      const results = await Promise.all(historyPromises);
      
      grid.innerHTML = results
        .map((streamer) => {
          const totalHours = streamer.sessions.reduce((sum, session) => {
            const start = session.start_time;
            const end = session.end_time || Date.now();
            return sum + (end - start);
          }, 0) / (1000 * 60 * 60);

          const recentSessions = streamer.sessions.slice(-5).reverse();
          return `
            <div class="streamer-card ${streamer.isLive ? 'is-live' : ''}">
              <div class="streamer-header">
                <h3>${streamer.name}</h3>
                ${streamer.isLive ? '<span class="live-badge">LIVE</span>' : ''}
              </div>
              ${!streamer.isLive && streamer.nextAppointment
                ? `<p class="appointment-time">下次预计直播：${streamer.nextAppointment}</p>`
                : ''}
              <div class="streamer-stats">
                <div class="stat">
                  <span class="stat-value">${streamer.sessions.length}</span>
                  <span class="stat-label">场次</span>
                </div>
                <div class="stat">
                  <span class="stat-value">${totalHours.toFixed(1)}</span>
                  <span class="stat-label">小时</span>
                </div>
              </div>
              <div class="session-list">
                ${recentSessions.length > 0
                  ? recentSessions.map((session) => {
                      const start = new Date(session.start_time);
                      const end = session.end_time ? new Date(session.end_time) : null;
                      const duration = end
                        ? ((end - start) / (1000 * 60 * 60)).toFixed(1) + ' 小时'
                        : '进行中';
                      return `
                        <div class="session-item ${!end ? 'session-live' : ''}">
                          <span class="session-date">${start.getMonth() + 1}/${start.getDate()}</span>
                          <span class="session-time">${start.getHours().toString().padStart(2, '0')}:${start.getMinutes().toString().padStart(2, '0')}</span>
                          <span class="session-duration">${duration}</span>
                        </div>
                      `;
                    }).join('')
                  : '<p class="no-sessions">最近30天无直播记录</p>'}
              </div>
            </div>
          `;
        })
        .join('');
    } catch (err) {
      console.error('Failed to load streaming history:', err);
      grid.innerHTML = '<p class="error-state">加载失败，请稍后重试</p>';
    }
  }

  // Load on page load
  loadStreamingHistory();
</script>

<style>
  .streaming-history {
    background: var(--paper);
    color: var(--ink);
  }

  .history-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .loading-state,
  .streaming-history :global(.error-state) {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem 1rem;
    color: var(--muted);
  }

  .loading-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--line);
    border-top-color: var(--purple);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 1rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .streaming-history :global(.streamer-card) {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.5rem;
    transition: transform 0.2s, border-color 0.2s;
  }

  .streaming-history :global(.streamer-card:hover) {
    transform: translateY(-2px);
    border-color: var(--purple);
  }

  .streaming-history :global(.streamer-card.is-live) {
    border-color: var(--purple);
    box-shadow: 0 0 20px color-mix(in srgb, var(--purple) 20%, transparent);
  }

  .streaming-history :global(.streamer-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .streaming-history :global(.streamer-header h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
  }

  .streaming-history :global(.live-badge) {
    display: inline-block;
    background: var(--purple);
    color: var(--ink);
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(0.98);
    }
  }

  .streaming-history :global(.streamer-stats) {
    display: flex;
    gap: 2rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .streaming-history :global(.appointment-time) {
    margin: -0.25rem 0 1rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .streaming-history :global(.stat) {
    display: flex;
    flex-direction: column;
  }

  .streaming-history :global(.stat-value) {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--deep);
    line-height: 1;
  }

  .streaming-history :global(.stat-label) {
    font-size: 0.875rem;
    color: var(--muted);
    margin-top: 0.25rem;
  }

  .streaming-history :global(.session-list) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .streaming-history :global(.session-item) {
    display: grid;
    grid-template-columns: 3rem 3rem 1fr;
    gap: 0.75rem;
    padding: 0.5rem;
    background: var(--lavender);
    border-radius: 6px;
    font-size: 0.875rem;
    border-left: 2px solid var(--line);
  }

  .streaming-history :global(.session-item.session-live) {
    border-left-color: var(--purple);
    background: color-mix(in srgb, var(--purple) 12%, var(--white));
  }

  .streaming-history :global(.session-date) {
    color: var(--muted);
    font-weight: 500;
  }

  .streaming-history :global(.session-time) {
    color: var(--ink);
    font-family: 'SF Mono', 'Courier New', monospace;
  }

  .streaming-history :global(.session-duration) {
    color: var(--deep);
    text-align: right;
    font-weight: 600;
  }

  .streaming-history :global(.no-sessions) {
    color: var(--muted);
    font-style: italic;
    text-align: center;
    padding: 1rem 0;
  }
</style>
